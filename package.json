{
  "name": "vallo",
  "private": true,
  "version": "0.1.0",
  "description": "Vallo. Nigeria-first property marketplace for renting, buying and selling.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vallo/web",
    "build": "npm run build --workspace @vallo/web",
    "start": "npm run start --workspace @vallo/web",
    "lint": "npm run lint --workspace @vallo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync:versions": "node scripts/sync-native-versions.mjs",
    "seed:reviewer": "node scripts/seed/store-reviewer.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.23",
    "@capacitor/assets": {
      "tar": "^7.5.21"
    },
    "vitest": {
      "std-env": "4.2.0"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
