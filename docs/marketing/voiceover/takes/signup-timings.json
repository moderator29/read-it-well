  "sentences": [
    {
      "i": 1,
      "start": 0.12,
      "end": 2.21,
      "text": "Getting on Vallo takes about a minute."
    },
    {
      "i": 2,
      "start": 2.454,
      "end": 5.722,
      "text": "Your name, your email, a password you choose."
    },
    {
      "i": 3,
      "start": 6.156,
      "end": 7.293,
      "text": "No long form."
    },
    {
      "i": 4,
      "start": 7.543,
      "end": 9.129,
      "text": "No agent to call first."
    },
    {
      "i": 5,
      "start": 9.364,
      "end": 10.322,
      "text": "Nothing to pay."
    },
    {
      "i": 6,
      "start": 10.776,
      "end": 20.264,
      "text": "Confirm your email, and the whole platform is open: homes to rent, homes to buy, hotels, shortlets and restaurants, all under the one account."
    },
    {
      "i": 7,
      "start": 20.693,
      "end": 27.103,
      "text": "Your shortlist, your conversations and your agreements stay with that account, on every device you open it on."
    },
    {
      "i": 8,
      "start": 27.537,
      "end": 31.863,
      "text": "And if you ever want to list a place of your own, the same account becomes your workspace."
    },
    {
      "i": 9,
      "start": 32.297,
      "end": 33.549,
      "text": "One minute to start."
    },
    {
      "i": 10,
      "start": 33.974,
      "end": 34.487,
      "text": "Vallo."
    },
    {
      "i": 11,
      "start": 34.856,
      "end": 36.572,
      "text": "Real estate, done right."
    }
  ],
