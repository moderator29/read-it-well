<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app target's privacy manifest (C15, 30 September 2026). Mirrors
  docs/store/PRIVACY_LABELS.md: no tracking, no tracking domains, no
  required-reason API called from the app's own Swift (Capacitor ships its
  own manifest for the bridge). Collected types match the App Privacy
  answers. Crash Data is NOT listed because SENTRY_DSN is unset; add
  NSPrivacyCollectedDataTypeCrashData (not linked, App Functionality) the
  day it is set, and change the App Store Connect answer the same day.
-->
<plist version="1.0">
