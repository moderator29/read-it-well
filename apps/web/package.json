{
  "name": "@vallo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=333 && node scripts/check-css-tokens.mjs && node scripts/check-valuation-words.mjs && node scripts/check-no-em-dash.mjs && node ../../scripts/check-migrations.mjs && npm run check:claims",
    "check:claims": "vitest run src/lib/trust/claims.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deep-links": "node scripts/check-deep-links.mjs",
    "check:a11y": "node tests/a11y-front-door.spec.mjs",
    "check:weight": "node scripts/check-weight.mjs",
    "check:height": "node scripts/check-landing-height.mjs",
    "prebuild": "node ../../scripts/build-scene-manifest.mjs && npm run check:claims",
    "shell:config": "node scripts/write-shell-config.mjs",
    "cap:sync": "node scripts/write-shell-config.mjs && node scripts/check-deep-links.mjs && npx cap sync",
    "cap:sync:dev": "node scripts/write-shell-config.mjs && node scripts/check-deep-links.mjs --warn && npx cap sync",
    "cap:sync:ios": "node scripts/write-shell-config.mjs && node scripts/check-deep-links.mjs --platform=ios && npx cap sync",
    "cap:sync:android": "node scripts/write-shell-config.mjs && node scripts/check-deep-links.mjs --platform=android && npx cap sync"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.0.4",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@paystack/inline-js": "2.25.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@types/leaflet": "^1.9.21",
    "@vallo/design-tokens": "*",
    "@vallo/i18n": "*",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
