# RentMe environment template. Copy to .env.local for local dev and mirror
# every value into the deploy platform (Vercel: Project Settings, Environment
# Variables). Never commit .env.local. Keys marked SERVER ONLY must never get
# the NEXT_PUBLIC_ prefix - that prefix compiles the value into the browser
# bundle, where anyone can read it.
#
# Nothing here throws on startup. Every integration is checked lazily and
# degrades to an honest state, so the platform boots and is walkable with this
# file completely empty. docs/ENVIRONMENT.md says exactly what each absence
# costs and where to go and get the credential.

# =========================================================== REQUIRED
# Without these four there are no accounts, no listings, and every picker
# reports that it could not load its list.

# ------------------------------------------------------------------ Supabase
# Dashboard: https://supabase.com/dashboard/project/uccixoonmbhrnyczyigt/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://uccixoonmbhrnyczyigt.supabase.co
# The anon / publishable key. Public by design: it only ever acts through Row
# Level Security. If the sign-up dropdowns are empty in production, check this
# one first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Service role bypasses RLS; used by admin jobs only. Reading it
# in a browser bundle throws by design.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Platform
# The deployment's own public URL. Auth redirects and every link inside an
# email are absolute, so this must match where the app actually runs. On Vercel
# preview builds the platform's own VERCEL_URL is used automatically when this
# is unset; set it explicitly for production.
NEXT_PUBLIC_SITE_URL=

# =========================================================== OPTIONAL
# Each one switches a feature on. Each absence has a designed, honest state.

# ------------------------------------------------- Auth providers (Supabase)
# Which social sign-in buttons to offer, comma separated: google, apple.
# Leave empty to offer email only. Only list a provider AFTER enabling it in
# the Supabase dashboard, because listing one that is not enabled sends people
# to an error page. The provider secrets themselves live in Supabase, never
# here:
#   Supabase Dashboard: Authentication > Providers > Google / Apple
#   Google OAuth client: https://console.cloud.google.com/apis/credentials
#   Apple Sign In:       https://developer.apple.com/account/resources/identifiers
# Apple is not optional once Google is offered: App Store guideline 4.8.
NEXT_PUBLIC_AUTH_PROVIDERS=

# ------------------------------------------------------------- AI assistant
# SERVER ONLY. Powers the assistant and the support escalation summariser.
# Absent: the assistant answers with an honest "not configured" message instead
# of pretending, and support falls back to its keyword FAQ store.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model pins. Default to claude-sonnet-5.
ASSISTANT_MODEL=
SUPPORT_MODEL=

# ------------------------------------------------------------------ Payments
# Paystack (Nigerian cards, transfers, USSD):
# https://dashboard.paystack.com/#/settings/developers
# SERVER ONLY. Checkout is a server-initiated redirect, so the browser never
# holds a Paystack key and there is no public one to set.
PAYSTACK_SECRET_KEY=

# -------------------------------------------------------- Transactional email
# Resend (booking confirmations, receipts): https://resend.com/api-keys
# SERVER ONLY. Absent: sendEmail returns {sent:false, reason:"unconfigured"}
# and nothing leaves the process.
RESEND_API_KEY=
# The From address on every platform email. Must be a verified sender on the
# Resend domain, or delivery is rejected. Defaults to
# "RentMe <hello@rentme.ng>" when unset. SERVER ONLY.
EMAIL_FROM=

# ------------------------------------------- Hybrid inventory (third party)
# See docs/HYBRID_INVENTORY.md for the model. Partner stock never carries the
# verified badge and never opens in-platform messaging.
# Amadeus Self-Service (third-party hotel inventory and booking):
# https://developers.amadeus.com/register then My Self-Service Workspace > Create app
# SERVER ONLY. Start on the test environment, switch AMADEUS_ENV to production
# after certification.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Google Places API (restaurant discovery and address autocomplete):
# https://console.cloud.google.com/apis/credentials (enable "Places API (New)")
# SERVER ONLY; calls go through our API layer so the key never ships to the
# browser and responses can be policy-cached.
GOOGLE_PLACES_API_KEY=

# --------------------------------------------------------------- Copy gates
# Six surfaces show a support address. Until this names a real mailbox they
# show the in-app route instead of an address that would bounce.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Naira to US dollar, e.g. 1600. The wallet's currency toggle does not appear
# until this is set. Gated rather than defaulted on purpose: an invented rate
# on a wallet balance is a lie about somebody's money.
NEXT_PUBLIC_NGN_USD_RATE=

# ------------------------------------------------------------- Data source
# `repository` (default) or `api`. Selects the listing and agent data source.
# Leave unset unless you know why you are changing it. Only the exact string
# `api` switches it; anything else, including a typo, is the default.
NF_DATA_SOURCE=

# ------------------------------------------------------------------- Testing
# Read only by the Playwright specs in apps/web/tests, never by the product.
# Each spec falls back to its own localhost port, so leave this unset unless
# you are pointing the suite at a deployed build.
BASE_URL=

# ============================================ NOT WIRED TO ANYTHING YET
# Listed so nobody wastes an afternoon wondering why setting them changed
# nothing. No code reads any of these today.
#
#   NEXT_PUBLIC_MAPTILER_KEY  The map renders on Carto's free basemap tiles,
#                             which are NON-COMMERCIAL USE ONLY. Moving to a
#                             licensed tile provider is a real pre-launch task
#                             and this is where the key will land.
#   TERMII_API_KEY            Phone/SMS OTP has not shipped.
#   NEXT_PUBLIC_POSTHOG_KEY   No analytics client is installed.
#   NEXT_PUBLIC_POSTHOG_HOST
#   SENTRY_DSN                No error reporting client is installed.
