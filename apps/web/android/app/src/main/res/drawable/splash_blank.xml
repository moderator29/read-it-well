<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 12+ system splash icon, deliberately empty (styles.xml,
    AppTheme.NoActionBarLaunch). Frame one of the startup sequence is the bare
    navy ground, so the system splash shows that ground and nothing on it; the
    web sequence then assembles the mark in its own place.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
