<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
        THE SYSTEM SPLASH MATCHES FRAME ONE OF THE STARTUP SEQUENCE (D31,
        MOTION_SYSTEM.md section 3, north star section 8).

        Android 12 and above draw their own splash from these two attributes
        and ignore `android:background` for it. Neither was set, so the system
        drew the launcher icon on its default ground, which no frame of Vallo
        ever matched. Frame one of the web sequence (0 to 120ms) is the bare
        navy ground: the mark only starts to assemble at 120ms, in the place
        Get Started's mark sits, not in the centre. So the system splash is the
        same navy with NO icon (a transparent drawable), and the handoff from
        the system to the page is the same colour on both sides of it.
        `splash_ground` is the night canvas, `--nf-surface-artwork`, written
        as a literal because an Android resource cannot read a CSS token.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>