# NaijaFinds environment template.
#
# Copy to `.env.local` and fill in. Never commit a real `.env`.
# Every value here is server side unless the name starts with NEXT_PUBLIC_,
# which is exposed to the browser bundle and must therefore never hold a secret.

# ---------------------------------------------------------------- application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Data source for discovery. "seed" uses local sample content and is the
# default. "api" targets the real platform API, which is not built yet.
NF_DATA_SOURCE="seed"

# ------------------------------------------------------------------- database
# PostgreSQL with PostGIS enabled. Used by the auth and platform services.
AUTH_DATABASE_URL=""

# ------------------------------------------------------------------ supabase
# Project URL and anon key are public: the anon key only ever acts through Row
# Level Security, so it is safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key bypasses RLS. Hard secret, server only. Used for privileged
# work: confirming bookings and writing the ledger, payment webhooks, admin
# approvals. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------------- auth
# Sign in providers. A provider is only offered in the UI when its variables
# are present, so leaving these blank disables that button rather than showing
# one that fails.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Sign in with X requires a paid API tier. Confirm budget before enabling.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Which sign-in buttons the UI offers, comma separated, e.g. "google,apple".
# Email and password work as soon as Supabase is configured, because Supabase
# issues the session itself. A SOCIAL provider only works once it is enabled in
# the Supabase dashboard, which this application cannot detect, so it is an
# explicit opt-in here. Offering a provider that is not enabled sends somebody
# to an error page, which is why the default is off.
NEXT_PUBLIC_AUTH_PROVIDERS=""

# ------------------------------------------------------------------ messaging
# Transactional email, used for verification and booking confirmations.
RESEND_API_KEY=""
# The From address on every transactional email. Must be a domain verified in
# Resend, or the provider refuses the send.
EMAIL_FROM=""

# The address every "contact support" link points at. With this unset, all six
# of those surfaces point at /contact instead, which opens a real support
# ticket. Set it only once the mailbox genuinely receives mail: an address that
# bounces is worse than no address, because it fails silently while the person
# who wrote believes they have asked.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# SMS and OTP.
TERMII_API_KEY=""

# ---------------------------------------------------------------------- media
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----------------------------------------------------------------------- maps
# Server key. Keep unrestricted keys out of the client at all times.
GOOGLE_MAPS_SERVER_KEY=""
# Places, for resolving real venues. Server side, and billed per request, so it
# is a separate key from the maps one and should be restricted to the Places
# API alone in the Google console.
GOOGLE_PLACES_API_KEY=""
# Browser key. Must be restricted by HTTP referrer in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# ------------------------------------------------------------------- payments
# Paystack. The public key is safe in the client, the secret never is.
#
# There is deliberately no webhook secret here, and there used to be a
# PAYSTACK_WEBHOOK_SECRET that nothing in the codebase ever read. Paystack does
# not issue one: it signs every webhook with an HMAC SHA-512 of the raw request
# body using your SECRET KEY, which is what `verifyWebhookSignature` uses. The
# phantom variable sent somebody hunting the dashboard for a field that does
# not exist, which is the whole cost of a template that lists a key the code
# does not read.
#
# Set the webhook URL itself in the Paystack dashboard, not here:
#   Settings -> API Keys & Webhooks -> Webhook URL
#   https://<your-domain>/api/paystack/webhook
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# --------------------------------------------------------- hotel connectivity
# Requires a signed commercial agreement before credentials are issued.
TRAVELGATE_API_KEY=""

# Amadeus, for hotel content and availability. The test environment is free and
# returns its own fixed inventory; production needs a commercial agreement.
# AMADEUS_ENV is the switch, and anything other than "production" stays on the
# test host, so an unset value cannot accidentally bill a live account.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"

# ------------------------------------------------------------------------- ai
ANTHROPIC_API_KEY=""
# Model overrides. Both fall back to a sensible default in code, so these are
# only for pinning a version or trying a different tier.
ASSISTANT_MODEL=""
SUPPORT_MODEL=""

# -------------------------------------------------------------- observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Naira per one US dollar, for the wallet's currency toggle.
# Leave blank and the toggle does not render at all - the wallet shows naira
# only. There is deliberately no fallback in code: an invented or stale rate
# sitting where a user reads their balance is worse than no conversion.
NEXT_PUBLIC_NGN_USD_RATE=""
