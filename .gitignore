# Parallel build outputs (see next.config.ts distDir)
apps/web/.next-*

# Derived icon artwork. `assets/brand-sheets` holds the founder's original
# sheets and is the only part that is source; everything below is one command
# away from existing again:
#
#   node scripts/slice-icon-sheets.mjs
#   node scripts/cut-icon-ground.mjs
#   node scripts/name-icon-objects.mjs
#
# The last of those writes the named set into apps/web/public/brand/glass,
# which IS committed, because that is what the product serves. The two
# intermediates are 37MB and nobody needs them in a clone.
assets/brand-sliced/
assets/brand-cut/

# Local screenshot-harness scratch. Ignored so a commit cannot accidentally
# ship a throwaway preview route or script under these names.
scripts/ownerA-*.mjs
scripts/ownerb-*.mjs
apps/web/src/app/(app)/ownerb-preview/

# Screenshot and measurement runs written by scripts/design/, scripts/probes/
# state-colours.mjs and the apps/web/tests/*-live.spec.mjs harnesses. They are
# local output, never documentation: 640 MB of them were once committed here.
docs/design/proofs/

# CI test report (DOC-P2-04)
vitest-junit.xml
