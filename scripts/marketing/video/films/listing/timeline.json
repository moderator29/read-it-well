 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 4.998,
   "text": "If you own a place, you can list it yourself."
  },
  {
   "i": 2,
   "start": 5.286,
   "end": 10.135,
   "text": "No agency fee. No middle man taking a cut you did not agree to."
  },
  {
   "i": 3,
   "start": 10.424,
   "end": 17.3,
   "text": "Add a workspace, tell Vallo what the place is, set your price and what it includes, and it is live."
  },
  {
   "i": 4,
   "start": 17.885,
   "end": 23.641,
   "text": "Renters see the whole cost on the listing, so the people who call you have already seen the real number."
  },
  {
   "i": 5,
   "start": 24.231,
   "end": 28.944,
   "text": "Ask for an inspection. Read the report. Then the agreement is drawn up."
  },
  {
   "i": 6,
   "start": 29.423,
   "end": 34.911,
   "text": "When it is paid, your share goes straight to your own bank account, through our licensed payments provider."
  },
  {
   "i": 7,
   "start": 35.2,
   "end": 37,
   "text": "Vallo never holds your money."
  },
  {
   "i": 8,
   "start": 37.5,
   "end": 40.636,
   "text": "Your place. Your price. Your account."
  },
  {
   "i": 9,
   "start": 40.962,
   "end": 43.746,
   "text": "Vallo. Real estate, done right."
  }
 ],
