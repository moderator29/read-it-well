 "sentences": [
  {
   "i": 1,
   "start": 2.3077,
   "end": 5.7047,
   "text": "Finding a place in Nigeria shouldn't feel like a gamble."
  },
  {
   "i": 2,
   "start": 6.9231,
   "end": 7.7261,
   "text": "Meet Vallo."
  },
  {
   "i": 3,
   "start": 8.1101,
   "end": 13.5801,
   "text": "Homes, hotels, shortlets and restaurants\u2026 all in one app, with one account."
  },
  {
   "i": 4,
   "start": 16.1538,
   "end": 17.0868,
   "text": "Here's how it works."
  },
  {
   "i": 5,
   "start": 17.5158,
   "end": 19.1268,
   "text": "Search across Nigeria."
  },
  {
   "i": 6,
   "start": 19.4608,
   "end": 25.3428,
   "text": "Filter by area, budget and bedrooms\u2026 save the ones you love, and compare them side by side."
  },
  {
   "i": 7,
   "start": 25.9615,
   "end": 29.5535,
   "text": "Open any listing and see the whole move-in cost up front."
  },
  {
   "i": 8,
   "start": 29.8775,
   "end": 36.4525,
   "text": "Rent, agency and legal fees, caution deposit\u2026 all added up, before you make a single call."
  },
  {
   "i": 9,
   "start": 36.9231,
   "end": 38.1251,
   "text": "Not sure about the price?"
  },
  {
   "i": 10,
   "start": 38.4351,
   "end": 41.7171,
   "text": "Vallo's price check shows you what homes nearby are asking."
  },
  {
   "i": 11,
   "start": 42.6923,
   "end": 47.3623,
   "text": "Then talk straight to the owner, the landlord or the agent, right inside the app."
  },
  {
   "i": 12,
   "start": 47.7243,
   "end": 53.2273,
   "text": "Send a message, call by voice or video, and book a viewing\u2026 in person, or by video."
  },
  {
   "i": 13,
   "start": 53.7263,
   "end": 57.9463,
   "text": "Viewings on Vallo are always free, with reminders so you never miss one."
  },
  {
   "i": 14,
   "start": 58.8462,
   "end": 64.1562,
   "text": "And if anyone drops an account number in the chat\u2026 Vallo flags it, so you stay safe."
  },
  {
   "i": 15,
   "start": 66.9231,
   "end": 67.7101,
   "text": "Ready to move in?"
  },
  {
   "i": 16,
   "start": 68.0551,
   "end": 69.5811,
   "text": "Pay with Protected payment."
  },
  {
   "i": 17,
   "start": 69.8801,
   "end": 75.1431,
   "text": "Your money is held in escrow by our licensed provider\u2026 and only released when the deal is done."
  },
  {
   "i": 18,
   "start": 75.5769,
   "end": 76.3309,
   "text": "Planning a trip?"
  },
  {
   "i": 19,
   "start": 76.6949,
   "end": 82.6509,
   "text": "Pick your dates, choose your room, and book a hotel or shortlet\u2026 with the full cost shown before you pay."
  },
  {
   "i": 20,
   "start": 83.6538,
   "end": 84.4128,
   "text": "Going out tonight?"
  },
  {
   "i": 21,
   "start": 84.7518,
   "end": 89.0968,
   "text": "Find a restaurant you love and secure your table with a deposit, in seconds."
  },
  {
   "i": 22,
   "start": 90.0,
   "end": 92.765,
   "text": "And your Vallo wallet keeps it all simple."
  },
  {
   "i": 23,
   "start": 93.132,
   "end": 96.955,
   "text": "Add money, pay, send and withdraw\u2026 in a few taps."
  },
  {
   "i": 24,
   "start": 97.5,
   "end": 103.364,
   "text": "Every naira, in your wallet, in escrow, in every payment, is held by our licensed provider."
  },
  {
   "i": 25,
   "start": 103.603,
   "end": 104.746,
   "text": "Never by Vallo."
  },
  {
   "i": 26,
   "start": 105.1,
   "end": 109.784,
   "text": "You get a receipt for every payment, and Vallo only earns when a deal is done."
  },
  {
   "i": 27,
   "start": 110.7692,
   "end": 119.4492,
   "text": "Every verified owner, host and business has been checked by a real person at Vallo, in four steps\u2026 so you know exactly who you're dealing with."
  },
  {
   "i": 28,
   "start": 120.0,
   "end": 120.699,
   "text": "Got a question?"
  },
  {
   "i": 29,
   "start": 121.02,
   "end": 123.457,
   "text": "Ask the Vallo assistant, any time of day."
  },
  {
   "i": 30,
   "start": 123.743,
   "end": 125.897,
   "text": "It will always tell you it's an AI."
  },
  {
   "i": 31,
   "start": 126.3462,
   "end": 128.4562,
   "text": "And Vallo speaks your language."
  },
  {
   "i": 32,
   "start": 128.7442,
   "end": 131.4382,
   "text": "English, Hausa, Yor\u00f9b\u00e1 and Igbo."
  },
  {
   "i": 33,
   "start": 133.8462,
   "end": 134.3822,
   "text": "Vallo."
  },
  {
   "i": 34,
   "start": 134.8262,
   "end": 136.4972,
   "text": "Real estate, done right."
  },
  {
   "i": 35,
   "start": 137.3077,
   "end": 139.5577,
   "text": "Live now on the App Store and Google Play."
  },
  {
   "i": 36,
   "start": 139.9717,
   "end": 141.3337,
   "text": "Download Vallo today."
  }
 ],
