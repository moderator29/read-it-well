 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 4.398,
   "text": "Getting on Vallo takes about a minute."
  },
  {
   "i": 2,
   "start": 4.686,
   "end": 7.954,
   "text": "Your name, your email, a password you choose."
  },
  {
   "i": 3,
   "start": 8.654,
   "end": 13.073,
   "text": "No long form. No agent to call first. Nothing to pay."
  },
  {
   "i": 4,
   "start": 13.362,
   "end": 16.39,
   "text": "Confirm your email, and the whole platform is open:"
  },
  {
   "i": 5,
   "start": 16.674,
   "end": 22.85,
   "text": "homes to rent, homes to buy, hotels, shortlets and restaurants, all under the one account."
  },
  {
   "i": 6,
   "start": 23.138,
   "end": 29.548,
   "text": "Your shortlist, your conversations and your agreements stay with that account, on every device you open it on."
  },
  {
   "i": 7,
   "start": 30,
   "end": 34.326,
   "text": "And if you ever want to list a place of your own, the same account becomes your workspace."
  },
  {
   "i": 8,
   "start": 34.615,
   "end": 35.867,
   "text": "One minute to start."
  },
  {
   "i": 9,
   "start": 36.346,
   "end": 39.216,
   "text": "Vallo. Real estate, done right."
  }
 ],
