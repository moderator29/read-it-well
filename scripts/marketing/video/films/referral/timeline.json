 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 5.147,
   "text": "Vallo pays you to bring people who are serious."
  },
  {
   "i": 2,
   "start": 5.435,
   "end": 6.652,
   "text": "Share your invite link."
  },
  {
   "i": 3,
   "start": 6.941,
   "end": 11.821,
   "text": "When a friend signs up with it and finishes verifying who they are, you earn eighty naira."
  },
  {
   "i": 4,
   "start": 12.115,
   "end": 17.754,
   "text": "Not for a click. Not for a download. For a real person, fully signed up."
  },
  {
   "i": 5,
   "start": 18.462,
   "end": 21.789,
   "text": "Your rewards balance sits in your account and you watch it climb."
  },
  {
   "i": 6,
   "start": 22.077,
   "end": 24.207,
   "text": "At one thousand naira, you can withdraw it."
  },
  {
   "i": 7,
   "start": 24.808,
   "end": 30.799,
   "text": "No limit on how many friends you bring, and no catch in the small print, because there is no small print."
  },
  {
   "i": 8,
   "start": 31.154,
   "end": 33.575,
   "text": "Share the link. Earn as they join."
  },
  {
   "i": 9,
   "start": 34.038,
   "end": 36.363,
   "text": "Vallo. Real estate, done right."
  }
 ],
