 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 5.359,
   "text": "Vallo pays you to bring people who are serious."
  },
  {
   "i": 2,
   "start": 5.679,
   "end": 7.035,
   "text": "Share your invite link."
  },
  {
   "i": 3,
   "start": 7.355,
   "end": 11.762,
   "text": "When a friend signs up fully with your link, you earn eighty naira."
  },
  {
   "i": 4,
   "start": 12.082,
   "end": 17.166,
   "text": "Not for a click. Not for a download. For a real person, fully signed up."
  },
  {
   "i": 5,
   "start": 17.486,
   "end": 21.893,
   "text": "Your Rewards Balance is what Vallo owes you, and you watch it climb."
  },
  {
   "i": 6,
   "start": 22.213,
   "end": 25.942,
   "text": "At one thousand naira, you can withdraw it to your bank."
  },
  {
   "i": 7,
   "start": 26.262,
   "end": 32.364,
   "text": "Up to fifteen hundred friends a month, and the terms sit on the screen, not in small print."
  },
  {
   "i": 8,
   "start": 32.684,
   "end": 35.056,
   "text": "Share the link. Earn as they join."
  },
  {
   "i": 9,
   "start": 35.376,
   "end": 37.071,
   "text": "Vallo. Real estate, done right."
  }
 ],
