 "sentences": [
  {
   "i": 1,
   "start": 2.3077,
   "end": 5.7847,
   "text": "Finding a place in Nigeria shouldn't feel like a gamble."
  },
  {
   "i": 2,
   "start": 6.9231,
   "end": 7.7411,
   "text": "Meet Vallo."
  },
  {
   "i": 3,
   "start": 8.6538,
   "end": 14.2008,
   "text": "Homes, hotels, shortlets and restaurants… all in one app, with one account."
  },
  {
   "i": 4,
   "start": 15.0,
   "end": 16.657,
   "text": "Looking for a home to rent or buy?"
  },
  {
   "i": 5,
   "start": 17.116,
   "end": 24.24,
   "text": "Search across Nigeria, filter by exactly what you need, and see the full move-in cost before you ever make a call."
  },
  {
   "i": 6,
   "start": 25.3846,
   "end": 29.5286,
   "text": "Rent, fees, caution deposit… all added up, right there."
  },
  {
   "i": 7,
   "start": 30.5769,
   "end": 34.8539,
   "text": "Talk straight to the owner, the landlord or the agent, right inside the app."
  },
  {
   "i": 8,
   "start": 35.2469,
   "end": 40.6689,
   "text": "Share listings in the chat, plan an inspection, and keep every conversation in one place."
  },
  {
   "i": 9,
   "start": 41.5385,
   "end": 42.3225,
   "text": "Planning a trip?"
  },
  {
   "i": 10,
   "start": 42.6815,
   "end": 48.2335,
   "text": "Browse hotels, shortlets and resorts… pick your dates… and book a room in a few taps."
  },
  {
   "i": 11,
   "start": 49.0385,
   "end": 49.8015,
   "text": "Going out tonight?"
  },
  {
   "i": 12,
   "start": 50.1605,
   "end": 53.7775,
   "text": "Find a restaurant you love and reserve your table in seconds."
  },
  {
   "i": 13,
   "start": 54.2308,
   "end": 62.0758,
   "text": "Owners, hosts, hotels and restaurants with the verified mark have been checked by a real person at Vallo… so you know who you're dealing with."
  },
  {
   "i": 14,
   "start": 63.0694,
   "end": 66.3424,
   "text": "And when it's time to pay… Vallo never holds your money."
  },
  {
   "i": 15,
   "start": 66.6364,
   "end": 71.8194,
   "text": "Your payment goes straight to the owner, the host or the business, through a licensed payment processor."
  },
  {
   "i": 16,
   "start": 72.6923,
   "end": 73.4353,
   "text": "Got a question?"
  },
  {
   "i": 17,
   "start": 73.7253,
   "end": 79.0333,
   "text": "Ask the AI assistant about prices, areas or how renting works… any time of day."
  },
  {
   "i": 18,
   "start": 79.6154,
   "end": 84.6344,
   "text": "And Vallo speaks your language: English, Hausa, Yorùbá and Igbo."
  },
  {
   "i": 19,
   "start": 85.3846,
   "end": 87.7056,
   "text": "Have a property, a hotel or a restaurant?"
  },
  {
   "i": 20,
   "start": 88.356,
   "end": 91.689,
   "text": "Put it on Vallo and welcome guests from across the country."
  },
  {
   "i": 21,
   "start": 92.3077,
   "end": 92.8277,
   "text": "Vallo."
  },
  {
   "i": 22,
   "start": 93.4615,
   "end": 95.2375,
   "text": "Real estate, done right."
  }
 ],
